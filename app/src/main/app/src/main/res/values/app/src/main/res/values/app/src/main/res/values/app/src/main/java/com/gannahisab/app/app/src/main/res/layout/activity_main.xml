<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl">
<TextView android:text="گنا حساب" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/green" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"/>
<TextView android:text="گنا خرید • ٹرالا • کسان کھاتہ • مل • خرچہ • منافع" android:textSize="15sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp"/>
<TextView android:id="@+id/summary" android:textSize="17sp" android:padding="16dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/buy" android:text="🌾 گنا خریداری درج کریں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/trip" android:text="🚛 نیا ٹرالا درج کریں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/payment" android:text="💰 کسان/پارٹی کو پیمنٹ" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/receipt" android:text="🏭 مل سے وصولی درج کریں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/expense" android:text="⛽ عام خرچہ درج کریں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/ledger" android:text="👨‍🌾 کسان کا کھاتہ دیکھیں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/report" android:text="📊 مکمل رپورٹ" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/exportCsv" android:text="📗 Excel/CSV رپورٹ بنائیں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/pdf" android:text="📄 PDF رپورٹ بنائیں" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
